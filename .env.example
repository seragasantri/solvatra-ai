# Salin jadi .env, lalu isi sesuai provider yang dipilih.

# Pilih provider: claude | codex | custom
TRAGA_PROVIDER=claude

# ── 1) CLAUDE (Anthropic, resmi) ─────────────────────────────
# Pakai SALAH SATU:
ANTHROPIC_API_KEY=sk-ant-...          # API key dari console.anthropic.com
# ANTHROPIC_AUTH_TOKEN=...            # OAuth token "SSO resmi" (mis. dari `ant auth login`)
# TRAGA_MODEL=claude-opus-5           # default; ganti claude-haiku-4-5 utk lebih murah
# TRAGA_EFFORT=low                    # low|medium|high|xhigh|max

# ── 2) CODEX / OPENAI (resmi) ────────────────────────────────
# TRAGA_PROVIDER=codex
# OPENAI_API_KEY=sk-...               # API key / OAuth bearer resmi dari akun/org kamu
# TRAGA_CODEX_MODEL=gpt-4o            # sesuaikan dgn model yang tersedia di akunmu
# TRAGA_CODEX_BASE_URL=https://api.openai.com/v1

# ── 3) CUSTOM ROUTER (OpenAI-compatible: OpenRouter, LiteLLM, ai-gateway, dll) ──
# TRAGA_PROVIDER=custom
# TRAGA_CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# TRAGA_CUSTOM_API_KEY=...
# TRAGA_CUSTOM_MODEL=anthropic/claude-3.5-sonnet
# TRAGA_CUSTOM_HEADERS={"HTTP-Referer":"https://situs-kamu","X-Title":"Traga"}

# ── Umum ─────────────────────────────────────────────────────
# TRAGA_NAME=Traga
# TRAGA_MEMORY_TOPK=8
